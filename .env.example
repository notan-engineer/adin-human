# ─────────────────────────────────────────────────────────────────────────────
# The Heuman Chef - environment template. Copy to `.env.local` and fill in.
# All integrations ship as working STUBS by default (no real keys needed to run).
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (used for canonical/OG/sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# ── Provider selection (which adapter the registry loads) ────────────────────
# payment:  yeshinvoice (default) | hyp | payplus | cardcom   ("stub" ⇒ yeshinvoice)
# delivery: stub
# invoice:  stub | hyp   (YeshInvoice folds invoicing into the payment adapter)
# orders:   memory | json
PAYMENT_PROVIDER=yeshinvoice
DELIVERY_PROVIDER=stub
INVOICE_PROVIDER=stub
ORDER_REPOSITORY=memory

# ── YeshInvoice (https://yeshinvoice.co.il/) - leave blank to use the STUB ───
# YeshInvoice is an invoicing platform with a hosted payment page. It is NOT an
# acquirer: it clears through a provider you contract SEPARATELY (Grow/Meshulam,
# Pelecard, Cardcom, Tranzila, Z-Credit, Upay, EasyCard…). A live integration
# therefore needs BOTH a YeshInvoice account AND your own merchant/clearing
# agreement. With both vars blank the adapter runs offline in stub mode.
#
# Auth note: the Authorization header is a JSON object literal, not a Bearer
# token:  Authorization: {"secret":"<SECRET>","userkey":"<USER_KEY>"}
# API note: Success:false still returns HTTP 200 - always branch on the body.
YESHINVOICE_SECRET=
YESHINVOICE_USERKEY=

# ⚠️ VERIFY BEFORE GO-LIVE: the ILS CurrencyID is ambiguous - YeshInvoice's docs
# say 2, their own WooCommerce plugin sends 1. Confirm for YOUR account with
# `POST /api/v1/getAllCurrencies` and set the correct value here.
YESHINVOICE_CURRENCY_ID_ILS=1

# Document issued on payment. 9 = חשבונית מס/קבלה (tax invoice + receipt).
YESHINVOICE_DOCUMENT_TYPE=9

# Hosted-page / document language ids. 359 = Hebrew, 139 = English.
YESHINVOICE_LANG_ID_HE=359
YESHINVOICE_LANG_ID_EN=139

# ── HYP / Hyp Pay (YaadPay protocol) - alternative provider, PAYMENT_PROVIDER=hyp
HYP_MASOF=
HYP_API_KEY=
HYP_PASSP=
HYP_MODE=sandbox            # sandbox | live
HYP_COIN=1                  # 1 = ILS (verify per terminal)

# ── Delivery carriers (future real adapters) - leave blank to use the stub ───
HFD_API_KEY=
ISRAEL_POST_TOKEN=
WOLT_DRIVE_API_KEY=

# ── Misc ─────────────────────────────────────────────────────────────────────
# VAT rate as a decimal (Israel standard rate). Verify current rate before go-live.
NEXT_PUBLIC_VAT_RATE=0.18
